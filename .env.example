# ===========================================
# mmserver – environment variables
# Copy to .env and set your values. Do not commit .env.
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# Database (MongoDB) – one of these
MONGODB_URI=mongodb://localhost:27017/mmproject
# MONGO_URI=mongodb://localhost:27017/mmproject

# JWT (auth)
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Telegram (AthenaBot) – health check & notifications
# Token from @BotFather. Subscribers: tracked via webhook (message/start → add, bot left → remove) or API.
ATHENABOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Webhook: Telegram sends updates to this URL. Set via POST /telegram/webhook/register (auth required).
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=optional-secret-telegram-sends-in-header

# Socket workers (mmscript): default is one connection per remote IP; second gets exit. Uncomment to allow same IP (NAT/Docker/dev).
# ALLOW_DUPLICATE_CLIENT_IP=1
